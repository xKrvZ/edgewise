# PostHog hobby stack — used with docker-compose.posthog.yml (not apps/api or apps/web).
#
# One-time setup (from repo root):
#   Windows: powershell -ExecutionPolicy Bypass -File .docker/posthog/bootstrap.ps1
#   Unix:    .docker/posthog/bootstrap.sh
#   (clones upstream compose files into .docker/posthog/posthog/ and creates .env from this file)
#
# Start PostHog + auto-provision keys into apps/api/.env and apps/web/.env:
#   docker compose -f .docker/posthog/docker-compose.hobby.yml -f docker-compose.posthog.yml --env-file .docker/posthog/.env up -d
#
# First boot takes 5–10 minutes (migrations, Kafka topics, ClickHouse). UI: http://localhost:8000
# posthog-bootstrap and posthog-provision run once after the web service is healthy.
# Existing non-empty keys are never overwritten. Cache: .docker/posthog/.provisioned.json (gitignored).
#
# Stop:
#   docker compose -f .docker/posthog/docker-compose.hobby.yml -f docker-compose.posthog.yml --env-file .docker/posthog/.env down
#
# Re-run provisioning only:
#   docker compose -f .docker/posthog/docker-compose.hobby.yml -f docker-compose.posthog.yml --env-file .docker/posthog/.env run --rm posthog-bootstrap
#   docker compose -f .docker/posthog/docker-compose.hobby.yml -f docker-compose.posthog.yml --env-file .docker/posthog/.env run --rm posthog-provision
#
# Manual fallback (existing PostHog instance or partial setup):
#   Open http://localhost:8000 → sign up → create project
#   Project Settings → Project API key (phc_...) → NEXT_PUBLIC_POSTHOG_KEY in apps/web/.env
#   Personal API Keys → new key with Query Read → POSTHOG_PERSONAL_API_KEY in apps/api/.env
#   Project Settings → Project ID → POSTHOG_PROJECT_ID in apps/api/.env
#   POSTHOG_HOST / NEXT_PUBLIC_POSTHOG_HOST = http://localhost:8000 (match POSTHOG_PORT below)
#
# Requires ~8 GB RAM free. Runs isolated from platform Postgres/Redis (separate containers).
# Alternative: use PostHog Cloud and set host to https://eu.i.posthog.com in apps/*/.env instead.
#
POSTHOG_PORT=8000
DOMAIN=localhost:8000
REGISTRY_URL=posthog/posthog
POSTHOG_APP_TAG=latest
POSTHOG_NODE_TAG=latest
DOCKER_REGISTRY_PREFIX=
TLS_BLOCK=
OPT_OUT_CAPTURE=false
# Django SECRET_KEY — min ~50 chars; change for anything beyond local dev.
POSTHOG_SECRET=local-dev-posthog-secret-change-me-before-any-shared-use-56chars
ENCRYPTION_SALT_KEYS=0123456789abcdef0123456789abcdef
BROWSERLESS_SECRET=local-dev-browserless-secret-32chars-minimum-length
