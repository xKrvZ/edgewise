{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "dev:api": "bun run --filter '@platform/api' dev",
    "dev:web": "bun run --filter '@platform/web' dev",
    "build:api": "bun run --filter '@platform/api' build",
    "build:web": "bun run --filter '@platform/web' build",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8"
  }
}
