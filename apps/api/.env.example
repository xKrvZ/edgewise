NODE_ENV=local

APP_NAME=platform
APP_DOMAIN=localhost
APP_PORT=3001
APP_SECRET=secret
# Frontend origin — used for Better Auth trustedOrigins, CORS, and password-reset links.
APP_FRONTEND_URL=http://localhost:3000

COOKIE_DOMAIN=localhost

SQL_DB_HOST=localhost
SQL_DB_PORT=5432
SQL_DB_USER=postgres
SQL_DB_PASSWORD=password
SQL_DB_SCHEMA=platform

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=password
REDIS_PREFIX=platform

# S3-compatible object storage (MinIO via docker-compose for local dev).
# S3_ENDPOINT must be reachable from the browser, since it signs presigned URLs.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=password
S3_BUCKET=platform
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_EXPIRY=900
S3_DOWNLOAD_EXPIRY=3600

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email (Better Auth verification & password reset OTPs).
# In local dev (NODE_ENV=local), emails are logged to the API console by default.
EMAIL_FROM=noreply@edgewise.app
EMAIL_FROM_NAME=Edgewise
EMAIL_LOG_ONLY=true
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Market data (default: mock — no API key required for local dev).
# Set MARKET_DATA_PROVIDER=polygon and POLYGON_API_KEY to use Massive (Polygon.io).
MARKET_DATA_PROVIDER=mock
POLYGON_API_KEY=
# Optional override (defaults to https://api.polygon.io).
# POLYGON_API_BASE_URL=https://api.polygon.io

# Billing via @polar-sh/better-auth plugin. Omit keys or set BILLING_PROVIDER=mock
# for local dev — all users are treated as subscribed with all features enabled.
#
# Polar dashboard setup:
#   1. Create subscription products (Starter $10/mo, Pro, Elite) and copy product IDs.
#   2. Create benefits with metadata slugs matching the feature map below.
#   3. Create an Organization Access Token → POLAR_ACCESS_TOKEN.
#   4. Add webhook endpoint → https://<api-host>/api/auth/polar/webhooks
#      and copy the signing secret → POLAR_WEBHOOK_SECRET.
#
# Internal Edgewise features (journal, analytics, …) map to Polar benefit slugs.
# Override per feature with FEATURE_<NAME>_POLAR_SLUG (e.g. FEATURE_JOURNAL_POLAR_SLUG=pro).
# Defaults: journal→pro, analytics→analytics, ai_review→ai_review, replay→replay,
#           backtest→backtest, community→community
BILLING_PROVIDER=mock
# MOCK_BILLING_PLAN=pro   # mock provider default plan: starter | pro | elite
# MOCK_FEATURES=all   # mock provider: comma-separated feature slugs or "all" (default)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
# POLAR_STARTER_PRODUCT_ID=   # Starter plan ($10/mo) — maps to starter billing plan
# POLAR_ELITE_PRODUCT_ID=   # preferred; POLAR_TEAM_PRODUCT_ID is a deprecated alias
# POLAR_CHECKOUT_SLUG=pro   # Better Auth checkout product slug (defaults to journal Polar slug)
# POLAR_ENTITLEMENT_SLUG=pro   # deprecated alias for POLAR_CHECKOUT_SLUG
# FEATURE_JOURNAL_POLAR_SLUG=pro
# FEATURE_ANALYTICS_POLAR_SLUG=analytics
# FEATURE_AI_REVIEW_POLAR_SLUG=ai_review
# FEATURE_REPLAY_POLAR_SLUG=replay
# FEATURE_BACKTEST_POLAR_SLUG=backtest
# FEATURE_COMMUNITY_POLAR_SLUG=community
# POLAR_ORGANIZATION_ID=   # required for Polar admin plan listing, refunds, and revenue charts
# POLAR_SERVER=sandbox     # sandbox | production (default)
#
# PostHog activation funnels (/admin/analytics funnel charts + weekly trend).
# Requires a personal API key with Query Read scope and the project ID from PostHog settings.
# Frontend also needs NEXT_PUBLIC_POSTHOG_KEY in apps/web/.env for client event capture.
# When unset, funnel charts show an empty state — there is no Postgres fallback.
#
# Local self-hosted PostHog (optional, ~8 GB RAM):
#   powershell -ExecutionPolicy Bypass -File .docker/posthog/bootstrap.ps1   # one-time
#   docker compose -f .docker/posthog/docker-compose.hobby.yml -f docker-compose.posthog.yml --env-file .docker/posthog/.env up -d
# Starts PostHog, waits for health, creates a dev org/project, and writes POSTHOG_* keys to
# apps/api/.env (+ .env.local) and apps/web/.env. Existing non-empty keys are never overwritten.
# Restart `bun run dev` after setup. See .docker/posthog/.env.example for stop/re-provision commands.
#
# Manual fallback:
#   Open http://localhost:8000 → Project Settings / Personal API Keys (see apps/web/.env.example)
# Or use PostHog Cloud: set POSTHOG_HOST=https://eu.i.posthog.com (or us.i.posthog.com).
# POSTHOG_PERSONAL_API_KEY=phx_...
# POSTHOG_PROJECT_ID=1
# POSTHOG_HOST=http://localhost:8000
#
# Admin billing endpoints (plan changes, cancellations, refunds) use the Polar SDK when
# BILLING_PROVIDER=polar. In mock mode, subscription state is stored in user_subscription.
