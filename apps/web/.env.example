# REST API base (includes /api prefix). Used by ApiStatus and data fetching.
# Public web app origin for share links (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Better Auth backend origin (no /api suffix). Optional if NEXT_PUBLIC_API_URL is set.
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
# Backend origin for websocket connections (market-data stream). Bare origin,
# no /api suffix — socket.io namespaces are appended to it.
NEXT_PUBLIC_WS_URL=http://localhost:3001
# TradingView Advanced Charting Library: copy licensed files to
# apps/web/public/charting_library/ (see lib/tradingview/README.md).
#
# Auth: verification and password-reset codes are sent by the API. In local dev
# (EMAIL_LOG_ONLY=true on the API), check the API terminal for OTP codes.
#
# Billing: mirror the API's BILLING_PROVIDER. Use mock for local dev (default).
# Feature access is resolved server-side — the web app reads enabled features from GET /billing/features.
NEXT_PUBLIC_BILLING_PROVIDER=mock
# Polar checkout product slug — must match API POLAR_CHECKOUT_SLUG (default: pro).
# NEXT_PUBLIC_POLAR_CHECKOUT_SLUG=pro
# NEXT_PUBLIC_POLAR_ENTITLEMENT_SLUG=pro   # deprecated alias for NEXT_PUBLIC_POLAR_CHECKOUT_SLUG
# Set to true to redirect all traffic to /503 (maintenance page).
# MAINTENANCE_MODE=true
#
# PostHog product analytics (optional — omit to disable tracking).
# Analytics is skipped when the key is missing, when Do Not Track is set, and on /admin + /share routes.
#
# Local self-hosted PostHog (optional, ~8 GB RAM):
#   powershell -ExecutionPolicy Bypass -File .docker/posthog/bootstrap.ps1   # one-time
#   docker compose -f .docker/posthog/docker-compose.hobby.yml -f docker-compose.posthog.yml --env-file .docker/posthog/.env up -d
# Auto-writes NEXT_PUBLIC_POSTHOG_KEY/HOST to apps/web/.env (and .env.local) when missing.
# See apps/api/.env.example and .docker/posthog/.env.example for full setup notes.
#
# Manual fallback:
#   Open http://localhost:8000 → project API key + host (or use PostHog Cloud)
# Or PostHog Cloud: https://posthog.com → project API key + https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=http://localhost:8000
#
# PostHog dashboard setup (Product analytics → Insights):
# Funnel — Acquisition → Activation → Conversion:
#   1. $pageview (marketing site) → user_signed_up → email_verified → onboarding_completed
#   2. onboarding_completed → journal_created (is_first=true) → trade_logged → subscription_completed
#   3. checkout_started → subscription_completed (break down by upgrade_trigger)
# Cohorts (retention):
#   - Signed up users who returned via session_started within 7 days
#   - Users with trades_milestone_10 who remain active subscribers
# Time-to-value (Person properties → set once on first events):
#   first_trade_at, first_journal_at, first_import_at, first_upgrade_at, onboarding_completed_at
# Feature adoption: feature_used broken down by feature_name
# Revenue attribution: plan_upgraded / subscription_completed by upgrade_trigger + trigger_feature
# Custom events: user_signed_in, user_signed_up, email_verified, onboarding_completed,
#   first_trade_imported, journal_created, trade_logged, trades_milestone_10, broker_connected,
#   community_joined, checkout_started, subscription_completed, plan_upgraded, feature_used, session_started
