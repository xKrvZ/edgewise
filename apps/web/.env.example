# REST API base (includes /api prefix). Used by ApiStatus and data fetching.
# Public web app origin for share links (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Better Auth backend origin (no /api suffix). Optional if NEXT_PUBLIC_API_URL is set.
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
# Backend origin for websocket connections (market-data stream). Bare origin,
# no /api suffix — socket.io namespaces are appended to it.
NEXT_PUBLIC_WS_URL=http://localhost:3001
# TradingView Advanced Charting Library: copy licensed files to
# apps/web/public/charting_library/ (see lib/tradingview/README.md).
#
# Auth: verification and password-reset codes are sent by the API. In local dev
# (EMAIL_LOG_ONLY=true on the API), check the API terminal for OTP codes.
